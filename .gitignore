# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Environments
.venv/
venv/
.env

# Jupyter
.ipynb_checkpoints/
*.ipynb

# OS / editor
.DS_Store
*.swp
*~

# Large data formats (C3: the predecessor accumulated multi-MB .ele/notebook artifacts
# at repo root — keep them out from day one)
*.ele
*.bun
*.h5
*.hdf5

# ...except the golden reference snapshots, which ARE committed by design (§7): they are
# the record of what another implementation answered, and a validation suite whose
# references have to be regenerated before it can run is not a validation suite. Tens of
# kB each, deliberately — see validation/make_references.py.
!src/gammaforge/validation/references/data/**/*.h5

# Sync-conflict variants (predecessor had .sync-conflict-*.ele duplicates from unsynced
# cloud-client edits)
*.sync-conflict-*
*sync-conflict*

# graphify knowledge graph — regenerable from the sources it indexes, and ~2 MB of
# graph.json + graph.html per build (C3). Rebuild with the graphify skill; `--update`
# re-extracts only what changed, using the manifest inside this directory.
graphify-out/

# Machine-local agent settings (the graphify hook hardcodes an absolute binary path).
# `settings.json` is the *shared* project file; anything machine-specific belongs here.
.claude/settings.local.json
